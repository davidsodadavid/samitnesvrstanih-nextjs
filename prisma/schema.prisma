// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostType {
  POST
  FILM
  EXHIBITION
  WORKSHOP
  CONCERT

  @@map("post_type")
}

model Post {
  id           Int      @id @default(autoincrement())
  type         PostType
  title        String
  description  String // rendered as rich-text markdown
  thumbnail    Image?   @relation(fields: [thumbnail_id], references: [id])
  thumbnail_id Int?
  photos       Photo[]
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("posts")
}

// Authored content photos (galleries, posts, DIYs) — distinct from utility Image uploads
model Photo {
  id        Int       @id @default(autoincrement())
  url       String
  key       String    @unique // R2 object key, needed to delete the object from the bucket
  date      DateTime? @db.Date
  author    String?
  posts     Post[]
  galleries Gallery[]
  diys      Diy[]

  @@map("photos")
}

model Gallery {
  id      Int     @id @default(autoincrement())
  year    Int     @unique
  authors String? // free-form credit line, independent of Photo.author
  photos  Photo[]

  @@map("galleries")
}

model Event {
  id            Int       @id @default(autoincrement())
  title         String
  description   String
  start_at      DateTime
  ends_at       DateTime
  location      Location  @relation(fields: [location_id], references: [id])
  location_id   Int
  event_type    EventType @relation(fields: [event_type_id], references: [id])
  event_type_id Int
  image         Image?    @relation(fields: [image_id], references: [id])
  image_id      Int?

  @@map("events")
}

model EventType {
  id      Int     @id @default(autoincrement())
  name    String
  color   String  @default("#3b82f6") // hex color used for map pins/legend
  icon    Image?  @relation(fields: [icon_id], references: [id])
  icon_id Int?
  events  Event[]

  @@map("event_types")
}

model Location {
  id          Int     @id @default(autoincrement())
  name        String
  lat         Float
  lng         Float
  description String
  events      Event[]
  diys        Diy[]

  @@map("locations")
}

model Diy {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  location    Location @relation(fields: [location_id], references: [id])
  location_id Int
  photos      Photo[]

  @@map("diys")
}

model Sponsor {
  id      Int    @id @default(autoincrement())
  name    String
  logo    Image  @relation(fields: [logo_id], references: [id])
  logo_id Int

  @@map("sponsors")
}

// Utility images uploaded via the admin dashboard (thumbnails, event images, sponsor logos)
model Image {
  id              Int       @id @default(autoincrement())
  url             String
  key             String    @unique // R2 object key, needed to delete the object from the bucket
  post_thumbnails Post[]
  events          Event[]
  sponsors        Sponsor[]
  event_types     EventType[]

  @@map("images")
}

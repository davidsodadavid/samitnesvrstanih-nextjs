// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Authored content photos (galleries) — distinct from utility Image uploads
model Photo {
  id        Int       @id @default(autoincrement())
  url       String
  key       String    @unique // R2 object key, needed to delete the object from the bucket
  date      DateTime? @db.Date
  author    String?
  galleries Gallery[]

  @@map("photos")
}

// Design assets uploaded via the admin dashboard — same shape as Photo, but
// not tied to a Gallery.
model Design {
  id     Int       @id @default(autoincrement())
  url    String
  key    String    @unique // R2 object key, needed to delete the object from the bucket
  date   DateTime? @db.Date
  author String?

  @@map("designs")
}

model Gallery {
  id       Int     @id @default(autoincrement())
  year     Int     @unique
  authors  String? // free-form credit line, independent of Photo.author
  photos   Photo[]
  image    Image?  @relation(fields: [image_id], references: [id]) // shown as the link/cover on the frontend
  image_id Int?

  @@map("galleries")
}

model Event {
  id            Int       @id @default(autoincrement())
  title         String
  description   String
  start_at      DateTime
  ends_at       DateTime
  location      Location  @relation(fields: [location_id], references: [id])
  location_id   Int
  event_type    EventType @relation(fields: [event_type_id], references: [id])
  event_type_id Int
  image         Image?    @relation(fields: [image_id], references: [id])
  image_id      Int?

  @@map("events")
}

model EventType {
  id      Int     @id @default(autoincrement())
  name    String
  color   String  @default("#3b82f6") // map pins/legend, and the homepage card's panel
  icon    Image?  @relation("EventTypeIcon", fields: [icon_id], references: [id])
  icon_id Int?
  art     Image?  @relation("EventTypeArt", fields: [art_id], references: [id]) // banner strip behind the homepage card's title
  art_id  Int?
  events  Event[]

  @@map("event_types")
}

model Location {
  id          Int     @id @default(autoincrement())
  name        String
  lat         Float
  lng         Float
  description String
  events      Event[]

  @@map("locations")
}

model Sponsor {
  id      Int    @id @default(autoincrement())
  name    String
  logo    Image  @relation(fields: [logo_id], references: [id])
  logo_id Int

  @@map("sponsors")
}

// Utility images uploaded via the admin dashboard (event images, sponsor logos)
model Image {
  id          Int         @id @default(autoincrement())
  url         String
  key         String      @unique // R2 object key, needed to delete the object from the bucket
  events      Event[]
  sponsors    Sponsor[]
  event_types EventType[] @relation("EventTypeIcon")
  event_type_arts EventType[] @relation("EventTypeArt")
  galleries   Gallery[]

  @@map("images")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Authored content photos (galleries) — distinct from utility Image uploads
model Photo {
  id        Int       @id @default(autoincrement())
  url       String
  key       String    @unique // R2 object key, needed to delete the object from the bucket
  date      DateTime? @db.Date
  author    String?
  galleries Gallery[]

  @@map("photos")
}

// Design assets uploaded via the admin dashboard — same shape as Photo, but
// not tied to a Gallery.
model Design {
  id     Int       @id @default(autoincrement())
  url    String
  key    String    @unique // R2 object key, needed to delete the object from the bucket
  date   DateTime? @db.Date
  author String?

  @@map("designs")
}

model Gallery {
  id        Int     @id @default(autoincrement())
  year      Int     @unique
  authors   String? // free-form credit line, independent of Photo.author
  photos    Photo[]
  banner    Image?  @relation("GalleryBanner", fields: [banner_id], references: [id]) // art filling the year's bar on /galleries
  banner_id Int?

  @@map("galleries")
}

model Event {
  id            Int         @id @default(autoincrement())
  title         String
  description   String
  start_at      DateTime
  ends_at       DateTime
  location      Location    @relation(fields: [location_id], references: [id])
  location_id   Int
  event_type    EventType   @relation(fields: [event_type_id], references: [id])
  event_type_id Int
  image         EventImage?

  @@map("events")
}

// An event's own image: exactly one, uploaded on the event form and deleted
// with the event. Deliberately not an Image — that table is the shared library
// browsable in the dashboard (sponsor logos, event type icons and art), and an
// event's image is only ever meant to be seen on that event.
model EventImage {
  id       Int    @id @default(autoincrement())
  url      String
  key      String @unique // R2 object key, needed to delete the object from the bucket
  event    Event  @relation(fields: [event_id], references: [id], onDelete: Cascade)
  event_id Int    @unique

  @@map("event_images")
}

model EventType {
  id      Int     @id @default(autoincrement())
  name    String
  color   String  @default("#3b82f6") // map pins/legend, and the homepage card's panel
  icon    Image?  @relation("EventTypeIcon", fields: [icon_id], references: [id])
  icon_id Int?
  art     Image?  @relation("EventTypeArt", fields: [art_id], references: [id]) // banner strip behind the homepage card's title
  art_id  Int?
  events  Event[]

  @@map("event_types")
}

model Location {
  id          Int     @id @default(autoincrement())
  name        String
  lat         Float
  lng         Float
  description String
  events      Event[]

  @@map("locations")
}

model Sponsor {
  id      Int    @id @default(autoincrement())
  name    String
  logo    Image  @relation(fields: [logo_id], references: [id])
  logo_id Int

  @@map("sponsors")
}

// Shared image library uploaded via the admin dashboard: sponsor logos and
// event type icons/art. Event images live in EventImage instead, so they never
// show up here.
model Image {
  id          Int         @id @default(autoincrement())
  url         String
  key         String      @unique // R2 object key, needed to delete the object from the bucket
  sponsors    Sponsor[]
  event_types EventType[] @relation("EventTypeIcon")
  event_type_arts EventType[] @relation("EventTypeArt")
  gallery_banners Gallery[]   @relation("GalleryBanner")

  @@map("images")
}
